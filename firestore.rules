rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Admins are the Google accounts listed here, signed in through Firebase Authentication.
    // Nothing about them is stored in the database. Put your Gmail address here (lowercase)
    // before publishing; add more addresses to give other people access.
    function adminEmails() {
      return ['your.name@gmail.com'];
    }

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in adminEmails();
    }

    function isValidPlayer(data) {
      return data.keys().hasOnly(['name', 'attempts', 'division', 'pdgaNumber', 'createdAt', 'updatedAt'])
        && data.name is string
        && data.name.size() > 0
        && data.name.size() <= 40
        && data.attempts is list
        && data.attempts.size() == 3
        && (data.get('division', null) == null
          || (data.division is string && data.division.size() <= 10))
        && (data.get('pdgaNumber', null) == null
          || (data.pdgaNumber is string && data.pdgaNumber.size() <= 9));
    }

    // Anyone can watch the leaderboard; only admins can change it.
    match /players/{playerId} {
      allow read: if true;
      allow create, update: if isAdmin() && isValidPlayer(request.resource.data);
      allow delete: if isAdmin();
    }

    // Holds no documents. The app reads adminAccess/{uid} after sign-in only to ask these
    // rules whether that user is an admin: the read is allowed exactly when isAdmin() is.
    match /adminAccess/{userId} {
      allow get: if request.auth != null && request.auth.uid == userId && isAdmin();
    }
  }
}
