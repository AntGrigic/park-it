# Copy to .env.local and fill in from Firebase console → Project settings → Your apps → Web app.
# Leave empty to run the app in demo mode (data kept in the browser only).
# For the GitHub Pages deploy, add the same names as repository secrets instead.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
